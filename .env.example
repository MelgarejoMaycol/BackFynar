PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
API_VERSION=1.0.0
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER.neon.tech/DATABASE?sslmode=require&channel_binding=require"
ALLOW_DEGRADED_START=false
ALLOW_DATABASE_TESTS=false
ALLOW_SHARED_DEV_DATABASE_TESTS=false
CORS_ORIGINS=http://localhost:5173,https://fynar.vercel.app
REQUEST_BODY_LIMIT=64kb
# false (directo), loopback (proxy local) o numero de proxies confiables entre 1 y 3.
TRUST_PROXY=false
LOG_LEVEL=debug
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=fynar-api
JWT_AUDIENCE=fynar-clients
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_PROVIDER=console
BREVO_API_KEY=
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_FROM=Fynar <no-reply@your-verified-domain.example>
EMAIL_REPLY_TO=support@your-verified-domain.example
APP_WEB_URL=http://localhost:5173
PASSWORD_RESET_PATH=/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_PATH=/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
LEGAL_VERSION=2026-08-12
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Argon2id: memoria en KiB, iteraciones y grado de paralelismo.
AUTH_PASSWORD_MEMORY_COST=65536
AUTH_PASSWORD_TIME_COST=3
AUTH_PASSWORD_PARALLELISM=1
