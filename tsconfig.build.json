{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "scripts",
    "prisma",
    "prisma.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
