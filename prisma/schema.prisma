/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model FinancialEvent {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String          @map("workspace_id") @db.Uuid
  type                 event_type
  title                String          @db.VarChar(160)
  description          String?
  amount               Decimal?        @db.Decimal(18, 2)
  currency             String          @default("COP") @db.Char(3)
  startsAt             DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime?       @map("ends_at") @db.Timestamptz(6)
  recurrenceRuleId     String?         @map("recurrence_rule_id") @db.Uuid
  relatedTransactionId String?         @map("related_transaction_id") @db.Uuid
  relatedDebtId        String?         @map("related_debt_id") @db.Uuid
  relatedGoalId        String?         @map("related_goal_id") @db.Uuid
  isCompleted          Boolean         @default(false) @map("is_completed")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  recurrenceRules      RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onUpdate: NoAction)
  debts                Debt?           @relation(fields: [relatedDebtId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  savingsGoals         SavingsGoal?    @relation(fields: [relatedGoalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions         Transaction?    @relation(fields: [relatedTransactionId], references: [id], onUpdate: NoAction)
  workspaces           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, startsAt], map: "idx_events_workspace_start")
  @@map("financial_events")
}

