  updatedAt                DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  recurrenceRules          RecurrenceRule?      @relation(fields: [workspaceId, recurrenceRuleId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  debts                    Debt?                @relation(fields: [workspaceId, relatedDebtId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)
  debtInstallments         DebtInstallment?     @relation(fields: [workspaceId, relatedDebtId, relatedDebtInstallmentId], references: [workspaceId, debtId, id], onDelete: Cascade, onUpdate: NoAction)
  recurringObligations     RecurringObligation? @relation(fields: [workspaceId, relatedObligationId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)
