model UserPreference {
  userId             String     @id @map("user_id") @db.Uuid
  defaultWorkspaceId String?    @map("default_workspace_id") @db.Uuid
  language           String     @default("es-CO") @db.VarChar(10)
  currency           String     @default("COP") @db.Char(3)
  timezone           String     @default("America/Bogota") @db.VarChar(60)
  dateFormat         String     @default("DD/MM/YYYY") @map("date_format") @db.VarChar(20)
  theme              String     @default("LIGHT") @db.VarChar(20)
  startScreen        String     @default("DASHBOARD") @map("start_screen") @db.VarChar(50)
  dashboardLayout    Json       @default("{}") @map("dashboard_layout")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  workspaces         Workspace? @relation(fields: [defaultWorkspaceId], references: [id], onUpdate: NoAction)
  users              User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_preferences")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model User {
  id                                               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                            String                   @unique @db.Citext
  passwordHash                                     String?                  @map("password_hash")
  firstName                                        String                   @map("first_name") @db.VarChar(80)
  lastName                                         String?                  @map("last_name") @db.VarChar(80)
  phone                                            String?                  @db.VarChar(30)
  avatarUrl                                        String?                  @map("avatar_url")
  isEmailVerified                                  Boolean                  @default(false) @map("is_email_verified")
  termsAcceptedAt                                  DateTime?                @map("terms_accepted_at") @db.Timestamptz(6)
  privacyAcceptedAt                                DateTime?                @map("privacy_accepted_at") @db.Timestamptz(6)
  legalVersion                                     String?                  @map("legal_version") @db.VarChar(40)
  isActive                                         Boolean                  @default(true) @map("is_active")
  lastLoginAt                                      DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt                                        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                        DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                                        DateTime?                @map("deleted_at") @db.Timestamptz(6)
  auditLogs                                        AuditLog[]
  authIdentities                                   AuthIdentity[]
  deviceTokens                                     DeviceToken[]
  financialSimulations                             FinancialSimulation[]
  notifications                                    Notification[]
  passwordResetTokens                              PasswordResetToken[]
  emailVerificationTokens                          EmailVerificationToken[]
  emailChangeRequests                              EmailChangeRequest[]
  refreshTokens                                    RefreshToken[]
  transactionAttachments                           TransactionAttachment[]
  transactions                                     Transaction[]
  userPreferences                                  UserPreference?
  workspaceMembersWorkspaceMembersInvitedByTousers WorkspaceMember[]        @relation("workspace_members_invited_byTousers")
  workspaceMembersWorkspaceMembersUserIdTousers    WorkspaceMember[]        @relation("workspace_members_user_idTousers")
  workspaces                                       Workspace[]

  @@map("users")
}

model WorkspaceMember {
  workspaceId                           String        @map("workspace_id") @db.Uuid
  userId                                String        @map("user_id") @db.Uuid
  roleId                                String        @map("role_id") @db.Uuid
  status                                member_status @default(ACTIVE)
  invitedBy                             String?       @map("invited_by") @db.Uuid
  joinedAt                              DateTime?     @map("joined_at") @db.Timestamptz(6)
  createdAt                             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  usersWorkspaceMembersInvitedByTousers User?         @relation("workspace_members_invited_byTousers", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles                                 Role          @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersWorkspaceMembersUserIdTousers    User          @relation("workspace_members_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces                            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([workspaceId, userId])
  @@index([userId, status], map: "idx_workspace_members_user")
  @@map("workspace_members")
}

model Workspace {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                 @db.VarChar(120)
  type                  workspace_type         @default(PERSONAL)
  baseCurrency          String                 @default("COP") @map("base_currency") @db.Char(3)
  timezone              String                 @default("America/Bogota") @db.VarChar(60)
  ownerUserId           String                 @map("owner_user_id") @db.Uuid
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)
  aiInsights            AiInsight[]
  auditLogs             AuditLog[]
  budgets               Budget[]
  categories            Category[]
  debts                 Debt[]
  financialAccounts     FinancialAccount[]
  financialEvents       FinancialEvent[]
  financialSimulations  FinancialSimulation[]
  forecasts             Forecast[]
  merchantCategoryRules MerchantCategoryRule[]
  notifications         Notification[]
  outboxEvents          OutboxEvent[]
  recurrenceRules       RecurrenceRule[]
  recurringObligations  RecurringObligation[]
  savingsGoals          SavingsGoal[]
  transactions          Transaction[]
  userPreferences       UserPreference[]
  workspaceMembers      WorkspaceMember[]
  users                 User                   @relation(fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("workspaces")
}

