  type                debt_type
  status              debt_status          @default(ACTIVE)
  currency            String               @default("COP") @db.Char(3)
  originalAmount      Decimal              @map("original_amount") @db.Decimal(18, 2)
  currentBalance      Decimal              @map("current_balance") @db.Decimal(18, 2)
  interestRate        Decimal              @default(0) @map("interest_rate") @db.Decimal(10, 7)
  interestRateBasis   interest_rate_basis  @default(EFFECTIVE_ANNUAL) @map("interest_rate_basis")
  interestType        interest_type        @default(FIXED) @map("interest_type")
  termMonths          Int?                 @map("term_months")
  installmentAmount   Decimal?             @map("installment_amount") @db.Decimal(18, 2)
  disbursementDate    DateTime?            @map("disbursement_date") @db.Date
  firstPaymentDate    DateTime?            @map("first_payment_date") @db.Date
  nextDueDate         DateTime?            @map("next_due_date") @db.Date
  paymentDay          Int?                 @map("payment_day") @db.SmallInt
  estimatedEndDate    DateTime?            @map("estimated_end_date") @db.Date
  notes               String?
  metadata            Json                 @default("{}")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  debtInstallments    DebtInstallment[]
  debtPayments        DebtPayment[]
  financialAccounts   FinancialAccount?    @relation(fields: [workspaceId, liabilityAccountId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  workspaces          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  financialEvents     FinancialEvent[]
