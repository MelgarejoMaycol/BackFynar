// PostgreSQL y el SQL oficial administran CHECK, triggers, extensiones e índices parciales/funcionales.
// No usar db push ni migrate reset para reconstruir este esquema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountBalanceSnapshot {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String           @map("account_id") @db.Uuid
  balance           Decimal          @db.Decimal(18, 2)
  capturedAt        DateTime         @map("captured_at") @db.Timestamptz(6)
  source            String           @default("SYSTEM") @db.VarChar(40)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  financialAccounts FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([accountId, capturedAt])
  @@map("account_balance_snapshots")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiInsight {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  type         insight_type
  title        String       @db.VarChar(180)
  summary      String
  severity     Int          @default(1) @db.SmallInt
  confidence   Decimal?     @db.Decimal(5, 4)
  data         Json         @default("{}")
  validFrom    DateTime?    @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime?    @map("valid_until") @db.Timestamptz(6)
  isRead       Boolean      @default(false) @map("is_read")
  isDismissed  Boolean      @default(false) @map("is_dismissed")
  modelVersion String?      @map("model_version") @db.VarChar(100)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  workspaces   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_insights_workspace_created")
  @@map("ai_insights")
}

model AuditLog {
  id          BigInt     @id @default(autoincrement())
  workspaceId String?    @map("workspace_id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  entityType  String     @map("entity_type") @db.VarChar(80)
  entityId    String?    @map("entity_id") @db.Uuid
  action      String     @db.VarChar(50)
  oldData     Json?      @map("old_data")
  newData     Json?      @map("new_data")
  ipAddress   String?    @map("ip_address") @db.Inet
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User?      @relation(fields: [userId], references: [id], onUpdate: NoAction)
  workspaces  Workspace? @relation(fields: [workspaceId], references: [id], onUpdate: NoAction)

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_audit_workspace_created")
  @@map("audit_logs")
}

model AuthIdentity {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  provider        provider_type
  providerSubject String        @map("provider_subject") @db.VarChar(255)
  providerEmail   String?       @map("provider_email") @db.Citext
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  users           User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model BudgetAccount {
  budgetId          String           @map("budget_id") @db.Uuid
