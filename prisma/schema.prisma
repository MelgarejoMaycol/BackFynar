// PostgreSQL y el SQL oficial administran CHECK, triggers, extensiones e índices parciales/funcionales.
// No usar db push ni migrate reset para reconstruir este esquema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountBalanceSnapshot {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String           @map("account_id") @db.Uuid
  balance           Decimal          @db.Decimal(18, 2)
  capturedAt        DateTime         @map("captured_at") @db.Timestamptz(6)
  source            String           @default("SYSTEM") @db.VarChar(40)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  financialAccounts FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([accountId, capturedAt])
  @@map("account_balance_snapshots")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiInsight {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  type         insight_type
  title        String       @db.VarChar(180)
  summary      String
  severity     Int          @default(1) @db.SmallInt
  confidence   Decimal?     @db.Decimal(5, 4)
  data         Json         @default("{}")
  validFrom    DateTime?    @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime?    @map("valid_until") @db.Timestamptz(6)
  isRead       Boolean      @default(false) @map("is_read")
  isDismissed  Boolean      @default(false) @map("is_dismissed")
  modelVersion String?      @map("model_version") @db.VarChar(100)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  workspaces   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_insights_workspace_created")
  @@map("ai_insights")
}

model AuditLog {
  id          BigInt     @id @default(autoincrement())
  workspaceId String?    @map("workspace_id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  entityType  String     @map("entity_type") @db.VarChar(80)
  entityId    String?    @map("entity_id") @db.Uuid
  action      String     @db.VarChar(50)
  oldData     Json?      @map("old_data")
  newData     Json?      @map("new_data")
  ipAddress   String?    @map("ip_address") @db.Inet
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User?      @relation(fields: [userId], references: [id], onUpdate: NoAction)
  workspaces  Workspace? @relation(fields: [workspaceId], references: [id], onUpdate: NoAction)

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_audit_workspace_created")
  @@map("audit_logs")
}

model AuthIdentity {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  provider        provider_type
  providerSubject String        @map("provider_subject") @db.VarChar(255)
  providerEmail   String?       @map("provider_email") @db.Citext
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  users           User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model BudgetAccount {
  budgetId          String           @map("budget_id") @db.Uuid
  accountId         String           @map("account_id") @db.Uuid
  financialAccounts FinancialAccount @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  budgets           Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([budgetId, accountId])
  @@map("budget_accounts")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model BudgetCategory {
  budgetId        String   @map("budget_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  allocatedAmount Decimal? @map("allocated_amount") @db.Decimal(18, 2)
  budgets         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories      Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([budgetId, categoryId])
  @@map("budget_categories")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Budget {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  name             String           @db.VarChar(120)
  period           budget_period    @default(MONTHLY)
  startsOn         DateTime         @map("starts_on") @db.Date
  endsOn           DateTime         @map("ends_on") @db.Date
  amount           Decimal          @db.Decimal(18, 2)
  currency         String           @db.Char(3)
  alertThreshold   Decimal          @default(80) @map("alert_threshold") @db.Decimal(5, 2)
  rolloverEnabled  Boolean          @default(false) @map("rollover_enabled")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  budgetAccounts   BudgetAccount[]
  budgetCategories BudgetCategory[]
  workspaces       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("budgets")
}

model Category {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String?                @map("workspace_id") @db.Uuid
  parentId              String?                @map("parent_id") @db.Uuid
  name                  String                 @db.VarChar(100)
  type                  category_type
  icon                  String?                @db.VarChar(80)
  color                 String?                @db.VarChar(20)
  isSystem              Boolean                @default(false) @map("is_system")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)
  budgetCategories      BudgetCategory[]
  categories            Category?              @relation("categoriesTocategories", fields: [parentId], references: [id], onUpdate: NoAction)
  otherCategories       Category[]             @relation("categoriesTocategories")
  workspaces            Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  merchantCategoryRules MerchantCategoryRule[]
  recurringObligations  RecurringObligation[]
  transactionSplits     TransactionSplit[]
  transactions          Transaction[]

  @@map("categories")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model DebtInstallment {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  debtId            String             @map("debt_id") @db.Uuid
  installmentNumber Int                @map("installment_number")
  dueDate           DateTime           @map("due_date") @db.Date
  openingBalance    Decimal            @map("opening_balance") @db.Decimal(18, 2)
  principalAmount   Decimal            @default(0) @map("principal_amount") @db.Decimal(18, 2)
  interestAmount    Decimal            @default(0) @map("interest_amount") @db.Decimal(18, 2)
  insuranceAmount   Decimal            @default(0) @map("insurance_amount") @db.Decimal(18, 2)
  feeAmount         Decimal            @default(0) @map("fee_amount") @db.Decimal(18, 2)
  totalAmount       Decimal            @map("total_amount") @db.Decimal(18, 2)
  paidAmount        Decimal            @default(0) @map("paid_amount") @db.Decimal(18, 2)
  closingBalance    Decimal            @map("closing_balance") @db.Decimal(18, 2)
  status            installment_status @default(PENDING)
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  debts             Debt               @relation(fields: [workspaceId, debtId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)
  debtPayments      DebtPayment[]
  financialEvents   FinancialEvent[]

  @@unique([debtId, installmentNumber])
  @@unique([workspaceId, debtId, id])
  @@index([workspaceId, status, dueDate], map: "idx_installments_workspace_status_due")
  @@map("debt_installments")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model DebtPayment {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  debtId             String           @map("debt_id") @db.Uuid
  installmentId      String?          @map("installment_id") @db.Uuid
  transactionId      String           @unique @map("transaction_id") @db.Uuid
  paidAt             DateTime         @map("paid_at") @db.Timestamptz(6)
  totalAmount        Decimal          @map("total_amount") @db.Decimal(18, 2)
  principalAmount    Decimal          @default(0) @map("principal_amount") @db.Decimal(18, 2)
  interestAmount     Decimal          @default(0) @map("interest_amount") @db.Decimal(18, 2)
  insuranceAmount    Decimal          @default(0) @map("insurance_amount") @db.Decimal(18, 2)
  feeAmount          Decimal          @default(0) @map("fee_amount") @db.Decimal(18, 2)
  extraPaymentAmount Decimal          @default(0) @map("extra_payment_amount") @db.Decimal(18, 2)
  idempotencyKey     String           @map("idempotency_key") @db.VarChar(100)
  reversedAt         DateTime?        @map("reversed_at") @db.Timestamptz(6)
  reversedBy         String?          @map("reversed_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  debts              Debt             @relation(fields: [workspaceId, debtId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)
  debtInstallments   DebtInstallment? @relation(fields: [workspaceId, debtId, installmentId], references: [workspaceId, debtId, id], onDelete: NoAction, onUpdate: NoAction)
  transactions       Transaction      @relation(fields: [workspaceId, transactionId], references: [workspaceId, id], onUpdate: NoAction)

  @@unique([workspaceId, transactionId])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, debtId, paidAt(sort: Desc)], map: "idx_debt_payments_workspace_debt_paid")
  @@index([workspaceId, installmentId], map: "idx_debt_payments_workspace_installment")
  @@map("debt_payments")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Debt {
