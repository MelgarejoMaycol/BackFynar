{
  "name": "backfynar",
  "version": "1.0.0",
  "description": "API backend de Fynar para gestión financiera personal",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "pretypecheck": "npm run prisma:generate",
    "postinstall": "npm run build",
    "build": "npm run prisma:generate && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "npm run prisma:migrate:deploy && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run --exclude \"tests/integration/**\" --exclude \"dist/**\" --exclude \".clean-validation-*/**\"",
    "test:watch": "vitest --exclude \"tests/integration/**\" --exclude \"dist/**\" --exclude \".clean-validation-*/**\"",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "sql:inventory": "tsx scripts/inventory-sql.ts",
    "db:verify": "tsx scripts/verify-database-schema.ts",
    "source:pack": "tsx scripts/package-source.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "tsx scripts/clean.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run prisma:validate",
    "prisma:validate": "tsx scripts/run-prisma-offline.ts validate",
    "prisma:generate": "tsx scripts/run-prisma-offline.ts generate",
    "prisma:seed": "prisma db seed",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "email:test": "tsx scripts/test-email.ts",
    "email:status": "tsx scripts/check-email-delivery.ts",
    "email:config": "tsx scripts/check-email-configuration.ts"
  },
  "keywords": [
    "node",
    "express",
    "backend",
    "api"
  ],
  "author": "Maycol",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "argon2": "0.45.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "multer": "^2.2.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "prisma": "^6.19.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
